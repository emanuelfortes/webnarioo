# --- Supabase ---------------------------------------------------------------
# URL do projeto. Usada no servidor e no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima. Vai para o navegador — só precisa de SELECT em `messages`
# para o realtime do chat. Todo o resto passa pelo servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de serviço. NUNCA prefixar com NEXT_PUBLIC_. Ignora RLS e só é lida
# em Server Actions e Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Admin ------------------------------------------------------------------
ADMIN_EMAIL=voce@acev.com.br

# Hash scrypt da senha. Gere com: npm run gerar-senha -- "sua-senha"
ADMIN_PASSWORD_HASH=

# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
