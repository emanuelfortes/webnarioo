# --- Supabase ---------------------------------------------------------------
# URL do projeto. Usada no servidor e no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima. Vai para o navegador — só precisa de SELECT em `messages`
# para o realtime do chat. Todo o resto passa pelo servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de serviço. NUNCA prefixar com NEXT_PUBLIC_. Ignora RLS e só é lida
# em Server Actions e Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Admin ------------------------------------------------------------------
ADMIN_EMAIL=voce@acev.com.br

# Hash scrypt da senha. Gere com: npm run gerar-senha -- "sua-senha"
ADMIN_PASSWORD_HASH=

# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Cloudinary (opcional) --------------------------------------------------
# Liga o botão "Enviar vídeo pelo painel" na aba Configuração do /admin.
# Sem elas, o campo de URL do vídeo continua funcionando normalmente.
#
# Nenhuma das duas é segredo: vão para o navegador por definição. Na Vercel,
# cadastre as duas como tipo "Config", não "Secret".
#
# O upload preset precisa ser do modo Unsigned:
#   Cloudinary > Settings > Upload > Upload presets > Add > Signing Mode: Unsigned
#
# Atenção ao plano free da Cloudinary: há limite de tamanho por vídeo, e um
# webinar de 75 min costuma passar dele. Para o arquivo grande, use o R2 e cole
# a URL no campo manual.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
